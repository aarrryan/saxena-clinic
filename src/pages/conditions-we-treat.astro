---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTABand from '../components/CTABand.astro';
import { conditionGroups } from '../data/topics';
const crumbs = [{ name: 'Conditions We Treat', path: '/conditions-we-treat/' }];
---
<Base title="Conditions We Treat — Skin, Hair, Scars & More | Saxena Clinic, Jabalpur" description="Skin, hair and scalp, scar, women’s health and facial conditions assessed by the specialist consultants at Saxena Skin and Cosmetic Clinic, Jabalpur." path="/conditions-we-treat/" crumbs={crumbs}>
  <PageHeader eyebrow="Conditions" title="Conditions we treat" lede="An overview of the conditions our consultants assess. Detailed guides are linked where available; for anything not listed, please ask the clinic." crumbs={crumbs} seed={4} />
  <div class="container section--tight groups">
    {conditionGroups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.heading}`}>
        <div class="gh">
          <h2 id={`g-${g.heading}`}>{g.heading}</h2>
          <p class="muted small">{g.intro}</p>
        </div>
        <ul>
          {g.items.map((it) => <li>{it.path ? <a href={it.path}>{it.label}<span aria-hidden="true"> →</span></a> : <span>{it.label}</span>}</li>)}
        </ul>
      </section>
    ))}
    <p class="small muted">Listing a condition here means our specialists can assess it. The treatment recommended — and whether a particular procedure is offered — is decided at consultation.</p>
  </div>
  <CTABand />
</Base>
<style>
  .groups { display: grid; gap: clamp(28px, 4vw, 48px); }
  .group { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px; padding-top: 28px; border-top: 1px solid var(--line-strong); }
  @media (max-width: 760px) { .group { grid-template-columns: 1fr; } }
  .gh h2 { font-size: clamp(1.4rem, 1.2rem + .9vw, 2rem); margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 0 24px; }
  li { padding: 12px 0; border-bottom: 1px solid var(--line); }
  li a { text-decoration: none; font-weight: 500; }
  li a:hover { text-decoration: underline; }
  li span { color: var(--ink-soft); }
</style>
