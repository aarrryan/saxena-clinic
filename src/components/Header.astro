---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-medallion.png';
import { specialities, primaryNav } from '../data/nav';
import { withBase } from '../lib/paths';
interface Props { path: string }
const { path } = Astro.props;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const specActive = specialities.some((s) => isCurrent(s.href));
---
<header class="site-header" data-header>
  <div class="bar glass">
    <a class="brand" href={withBase("/")} aria-label="Saxena Skin and Cosmetic Clinic — home">
      <Image src={logo} alt="" width={40} height={40} class="brand-mark" loading="eager" />
      <span class="brand-text"><strong>Saxena</strong><span>Skin and Cosmetic Clinic</span></span>
    </a>

    <nav class="primary" aria-label="Primary">
      <ul>
        <li><a href={withBase("/our-doctors/")} aria-current={isCurrent('/our-doctors/') ? 'page' : undefined}>Our Doctors</a></li>
        <li class="has-panel">
          <button type="button" class="panel-toggle" aria-expanded="false" aria-controls="spec-panel" data-panel-toggle aria-current={specActive ? 'true' : undefined}>
            Specialities <svg aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </button>
          <div class="panel glass" id="spec-panel" data-panel>
            <ul class="panel-grid">
              {specialities.map((s) => (
                <li><a href={withBase(s.href)} aria-current={isCurrent(s.href) ? 'page' : undefined}><span>{s.label}</span><small>{s.blurb}</small></a></li>
              ))}
            </ul>
          </div>
        </li>
        <li><a href={withBase("/conditions-we-treat/")} aria-current={isCurrent('/conditions-we-treat/') ? 'page' : undefined}>Conditions</a></li>
        <li><a href={withBase("/patient-education/")} aria-current={isCurrent('/patient-education/') ? 'page' : undefined}>Patient Education</a></li>
        <li><a href={withBase("/about-us/")} aria-current={isCurrent('/about-us/') ? 'page' : undefined}>About</a></li>
      </ul>
    </nav>

    <a class="btn btn--sand cta" href={withBase("/contact-us/#enquiry")}>Request an appointment</a>

    <a class="menu-btn" href="#site-footer-nav" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle>
      <span class="menu-label">Menu</span><span class="burger" aria-hidden="true"><i></i><i></i></span>
    </a>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {primaryNav.map((n) => <li><a href={withBase(n.href)} aria-current={isCurrent(n.href) && (n.href !== '/' || path === '/') ? 'page' : undefined}>{n.label}</a></li>)}
        <li><a href={withBase("/cosmetic-gynaecology/")}>Cosmetic Gynaecology</a></li>
        <li><a href={withBase("/cranio-maxillofacial-surgery/")}>Maxillofacial Surgery</a></li>
      </ul>
      <a class="btn" href={withBase("/contact-us/#enquiry")}>Request an appointment <span class="arrow" aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding: 12px clamp(8px, 1.2vw, 18px) 0; }
  .bar { display: flex; align-items: center; gap: 16px; max-width: calc(var(--max) + 2 * var(--pad)); margin-inline: auto; padding: 10px 10px 10px 16px; border-radius: 999px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .brand :global(.brand-mark) { width: 40px; height: 40px; border-radius: 50%; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong { font-size: 1.02rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  .brand-text span { font-size: .72rem; color: var(--muted); letter-spacing: .04em; }
  .primary { margin-left: auto; }
  .primary > ul { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .primary a, .panel-toggle { display: inline-flex; align-items: center; gap: 6px; padding: 10px 14px; border-radius: 999px; font: 500 .92rem/1 var(--font); color: var(--ink); text-decoration: none; background: none; border: 0; cursor: pointer; }
  .primary a:hover, .panel-toggle:hover { background: rgba(23,23,21,.05); }
  .primary [aria-current] { background: rgba(23,23,21,.06); }
  .panel-toggle svg { transition: transform .3s var(--ease); }
  .panel-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .has-panel { position: relative; }
  .panel { position: absolute; top: calc(100% + 14px); left: 50%; transform: translateX(-50%); width: min(640px, 80vw); border-radius: 24px; padding: 14px; display: none; }
  .panel.open { display: block; }
  .panel-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .panel-grid a { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 14px 16px; border-radius: 16px; line-height: 1.25; }
  .panel-grid small { color: var(--muted); font-size: .8rem; font-weight: 400; }
  .cta { min-height: 44px; flex: none; }
  .menu-btn { display: none; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px; background: var(--ink); color: var(--porcelain); text-decoration: none; font: 500 .9rem/1 var(--font); margin-left: auto; min-height: 44px; }
  .burger { display: inline-grid; gap: 4px; width: 16px; }
  .burger i { display: block; height: 1.5px; background: currentColor; transition: transform .3s var(--ease); }
  .menu-btn[aria-expanded='true'] .burger i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .burger i:last-child { transform: translateY(-2.75px) rotate(-45deg); }
  .mobile-menu { position: fixed; inset: 78px clamp(8px, 1.2vw, 18px) auto; max-height: calc(100dvh - 92px); overflow: auto; background: var(--porcelain); border: 1px solid var(--line); border-radius: 24px; padding: 18px; box-shadow: var(--shadow); }
  .mobile-menu ul { list-style: none; margin: 0 0 16px; padding: 0; }
  .mobile-menu li a { display: block; padding: 13px 8px; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 1.05rem; }
  .mobile-menu [aria-current] { font-weight: 600; }
  .mobile-menu .btn { width: 100%; }
  @media (max-width: 1180px) { .primary a, .panel-toggle { padding: 10px 10px; } }
  @media (max-width: 1080px) { .primary, .cta { display: none; } .menu-btn { display: inline-flex; } }
  @media (max-width: 380px) { .brand-text span { display: none; } .menu-label { display: none; } }
</style>
