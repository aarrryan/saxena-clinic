---
import TopoArt from './TopoArt.astro';
interface Props { title?: string; text?: string }
const { title = 'Speak to a specialist', text = 'Send an appointment enquiry and the clinic will contact you to arrange a consultation with the right consultant.' } = Astro.props;
---
<section class="cta-band container section--tight" aria-labelledby="cta-h">
  <div class="box">
    <TopoArt class="art" seed={5} rings={9} cx={0.82} cy={0.5} dot={false} />
    <div class="txt">
      <h2 id="cta-h">{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--sand" href="/contact-us/#enquiry">Request an appointment <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .box { position: relative; overflow: hidden; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: clamp(32px, 5vw, 64px); background: var(--ink); color: var(--porcelain); border-radius: var(--r-lg); }
  .box :global(.art) { position: absolute; right: -10%; top: -40%; width: 60%; height: 180%; opacity: .5; pointer-events: none; }
  .txt { position: relative; max-width: 56ch; }
  h2 { font-size: var(--fs-h2); margin-bottom: 12px; }
  p { margin: 0; color: #D9D2C6; }
  .btn { position: relative; color: var(--ink); }
</style>
