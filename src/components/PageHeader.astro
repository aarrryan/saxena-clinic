---
import Breadcrumbs from './Breadcrumbs.astro';
import TopoArt from './TopoArt.astro';
import type { Crumb } from '../layouts/Base.astro';
interface Props { eyebrow: string; title: string; lede?: string; crumbs: Crumb[]; seed?: number }
const { eyebrow, title, lede, crumbs, seed = 2 } = Astro.props;
---
<section class="page-header frame">
  <div class="inner surface">
    <TopoArt class="art" seed={seed} rings={11} cx={0.62} cy={0.52} />
    <div class="container content">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </div>
</section>
<style>
  .page-header { margin-top: 14px; }
  .inner { position: relative; overflow: hidden; padding: clamp(40px, 6vw, 96px) 0 clamp(44px, 6vw, 88px); }
  .inner :global(.art) { position: absolute; right: -6%; top: -12%; width: min(52%, 640px); height: 130%; opacity: .7; pointer-events: none; }
  @media (max-width: 820px) { .inner :global(.art) { opacity: .28; width: 90%; right: -30%; } }
  .content { position: relative; display: grid; gap: 18px; }
  .content h1 { max-width: 16ch; }
  .content .lede { margin: 0; }
</style>
