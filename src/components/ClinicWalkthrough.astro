---
/**
 * "Inside the clinic" — the homepage's scroll-controlled centrepiece.
 *
 * Four short loops of the clinic's own rooms (filmed July 2026, no patients) start at the outer edges and,
 * as the visitor scrolls, move one by one into a 2 × 2 composition around the clinic's mark, each panel
 * angled in towards the centre. Titles reveal as each panel arrives; the mark and an appointment link
 * appear last, then the section releases and the page continues.
 *
 * Progressive enhancement:
 *  - Markup and CSS alone render the finished composition, static and un-pinned (no-JS / failed JS).
 *  - src/scripts/site.ts adds `.walk--live` (tall, pinned, scroll-driven) only when motion is allowed and
 *    the screen is tall enough; with prefers-reduced-motion the static composition stays, with posters.
 *  - Videos are muted, inline, preload="none"; their sources are attached only when the section nears
 *    the viewport, and they pause off-screen or via the Pause button (WCAG 2.2.2).
 * All URLs go through withBase() so the section works under the GitHub Pages base path.
 */
import { Image, getImage } from 'astro:assets';
import { withBase } from '../lib/paths';
import logo from '../assets/brand/logo-medallion.png';
import laserSuite from '../assets/clinic-media/laser-suite.jpg';
import treatmentRoom from '../assets/clinic-media/treatment-room.jpg';
import co2Laser from '../assets/clinic-media/co2-laser.jpg';
import procedureRoom from '../assets/clinic-media/procedure-room.jpg';

const raw = [
  { n: '01', title: 'Laser suite', line: 'Laser and energy-based devices in a dedicated room.', poster: laserSuite, video: '/media/clinic/laser-suite.mp4',
    label: 'Slow pan across the clinic’s laser suite: treatment couch, stool and laser devices.' },
  { n: '02', title: 'Treatment room', line: 'An adjustable procedure chair under a surgical light.', poster: treatmentRoom, video: '/media/clinic/treatment-room.mp4',
    label: 'The clinic’s treatment room: a tan procedure chair, surgical light and two devices.' },
  { n: '03', title: 'Fractional CO2 laser', line: 'Italian DEKA technology, in clinic.', poster: co2Laser, video: '/media/clinic/co2-laser.mp4',
    label: 'Close view of the clinic’s DEKA SmartXide fractional CO2 laser unit.' },
  { n: '04', title: 'Procedure room', line: 'A private room for longer procedures.', poster: procedureRoom, video: '/media/clinic/procedure-room.mp4',
    label: 'The clinic’s procedure room: reclining chair, wooden blinds and a laser unit.' },
];
const panels = await Promise.all(raw.map(async (p) => ({
  ...p,
  posterSrc: (await getImage({ src: p.poster, format: 'webp', width: 720, quality: 72 })).src,
})));
---
<section class="walk" data-walk aria-labelledby="walk-h">
  <div class="walk-pin">
    <header class="walk-intro">
      <p class="eyebrow">Inside the clinic</p>
      <h2 id="walk-h">Four rooms. One standard of care.</h2>
    </header>

    <div class="walk-stage">
      <ul class="walk-grid" role="list">
        {panels.map((p, i) => (
          <li class={`wp wp-${i + 1}`} data-panel>
            <figure>
              <div class="wp-media" role="img" aria-label={p.label}>
                <video muted playsinline loop preload="none" poster={p.posterSrc} data-src={withBase(p.video)} aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
              </div>
              <figcaption>
                <span class="wp-n">{p.n}</span>
                <span class="wp-t">{p.title}</span>
                <span class="wp-l">{p.line}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <div class="walk-core" data-core>
        <Image src={logo} alt="" width={88} height={88} class="walk-mark" loading="lazy" />
        <p class="walk-name">Saxena Skin and <br />Cosmetic Clinic</p>
        <p class="walk-sub">Specialist care. Advanced expertise.</p>
        <a class="btn" href={withBase('/contact-us/')}>Request an appointment <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

    <button type="button" class="walk-toggle glass" data-walk-toggle aria-pressed="false" hidden>Pause videos</button>
    <div class="walk-progress" aria-hidden="true"><span data-walk-bar></span></div>
  </div>
</section>

<style>
  /* ---------- Static composition (default: no JS, reduced motion, short screens) ---------- */
  .walk { --pw: clamp(170px, 19vw, 270px); --core: clamp(240px, 24vw, 340px); --tilt: 16deg; --tiltx: 5deg;
          position: relative; background: var(--porcelain); border-block: 1px solid var(--line); margin-top: clamp(24px, 4vw, 56px); }
  .walk-pin { position: relative; padding: clamp(56px, 7vw, 96px) var(--pad); display: grid; align-content: center; justify-items: center; gap: clamp(20px, 3vh, 40px); overflow: hidden; perspective: 1500px; }
  .walk-intro { text-align: center; display: grid; justify-items: center; gap: 10px; }
  .walk-intro h2 { font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.6rem); letter-spacing: -.02em; line-height: 1.05; }

  .walk-stage { display: grid; grid-template-columns: var(--pw) var(--core) var(--pw); grid-template-rows: auto auto; column-gap: clamp(20px, 3vw, 52px); row-gap: clamp(14px, 2.2vh, 28px); align-items: start; transform-style: preserve-3d; }
  .walk-grid { display: contents; list-style: none; margin: 0; padding: 0; }
  .wp-1 { grid-area: 1 / 1; } .wp-2 { grid-area: 1 / 3; } .wp-3 { grid-area: 2 / 1; } .wp-4 { grid-area: 2 / 3; }
  .walk-core { grid-area: 1 / 2 / 3 / 3; align-self: center; display: grid; justify-items: center; text-align: center; gap: 10px; }

  /* Each panel faces in towards the centre: left column turns right, right column turns left; top tilts down, bottom up.
     --k is that panel's arrival (0 = waiting at the outer edge, 1 = in place). */
  .wp { --k: 1; --ry: var(--tilt); --rx: calc(var(--tiltx) * -1); --dx: -26vw; --dy: -8vh; transform-style: preserve-3d; }
  .wp-2 { --ry: calc(var(--tilt) * -1); --dx: 26vw; }
  .wp-3 { --rx: var(--tiltx); --dy: 8vh; }
  .wp-4 { --ry: calc(var(--tilt) * -1); --rx: var(--tiltx); --dx: 26vw; --dy: 8vh; }
  .wp figure { position: relative; margin: 0;
    transform: translate3d(calc(var(--dx) * (1 - var(--k))), calc(var(--dy) * (1 - var(--k))), 0)
               rotateY(calc(var(--ry) * (1 + 1.6 * (1 - var(--k))))) rotateX(var(--rx)) scale(calc(.8 + .2 * var(--k)));
    opacity: calc(.28 + .72 * var(--k)); will-change: transform, opacity; }
  .wp-1 figure, .wp-3 figure { transform-origin: 100% 50%; }
  .wp-2 figure, .wp-4 figure { transform-origin: 0% 50%; }
  .wp-media { aspect-ratio: 4 / 5; border-radius: var(--r-sm); overflow: hidden; background: var(--sand-soft); box-shadow: 0 34px 60px -36px rgba(23,23,21,.5); }
  .wp-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* title sits inside the panel, on a soft shade, and rises in as the panel lands */
  .wp figcaption { --t: clamp(0, calc((var(--k) - .55) * 2.4), 1); position: absolute; inset: auto 0 0 0; padding: 44px 16px 14px; border-radius: 0 0 var(--r-sm) var(--r-sm);
    background: linear-gradient(to top, rgba(18,18,16,.72), rgba(18,18,16,0)); color: #F6F3ED; pointer-events: none;
    display: grid; grid-template-columns: auto 1fr; column-gap: 10px; row-gap: 3px; align-items: baseline;
    opacity: var(--t); transform: translateY(calc(10px * (1 - var(--t)))); }
  .wp-n { font-size: .7rem; font-weight: 600; letter-spacing: .14em; color: #E3D3B4; }
  .wp-t { font-weight: 600; letter-spacing: -.01em; font-size: clamp(.95rem, .85rem + .35vw, 1.1rem); }
  .wp-l { grid-column: 2; font-size: .82rem; color: rgba(246,243,237,.86); line-height: 1.35; }

  .walk-core { --c: 1; opacity: var(--c); transform: translateY(calc(14px * (1 - var(--c)))) scale(calc(.94 + .06 * var(--c))); }
  .walk-mark { width: clamp(56px, 6vw, 84px); height: auto; border-radius: 50%; margin-bottom: 4px; }
  .walk-name { font-size: clamp(1.15rem, .9rem + 1vw, 1.6rem); font-weight: 600; letter-spacing: -.015em; line-height: 1.15; }
  .walk-sub { font-size: .7rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--champagne-ink); margin-bottom: 8px; }

  .walk-toggle { position: absolute; right: var(--pad); bottom: 20px; min-height: 44px; padding: 0 18px; border-radius: 999px; font: 500 .85rem/1 var(--font); color: var(--ink); cursor: pointer; border: 1px solid var(--line-strong); }
  .walk-toggle:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }
  .walk-progress { display: none; }

  /* ---------- Phones and narrow tablets: same idea, re-composed (2 × 2, mark below) ---------- */
  @media (max-width: 760px), (max-width: 1100px) and (orientation: portrait) {
    .walk { --tilt: 8deg; --tiltx: 3deg; }
    .walk-stage { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto; column-gap: 12px; row-gap: 12px; width: 100%; max-width: 560px; }
    .wp-1 { grid-area: 1 / 1; } .wp-2 { grid-area: 1 / 2; } .wp-3 { grid-area: 2 / 1; } .wp-4 { grid-area: 2 / 2; }
    .wp { --dx: -34vw; } .wp-2, .wp-4 { --dx: 34vw; }
    .walk-core { grid-area: 3 / 1 / 4 / 3; margin-top: 6px; gap: 8px; }
    .walk-core .walk-mark, .walk-core .walk-sub { display: none; }
    .walk-core br { display: none; }
    .walk-name { font-size: 1.05rem; }
    .wp-l { display: none; }
    .wp figcaption { padding: 32px 12px 10px; }
    .walk-toggle { position: static; justify-self: center; }
  }

  /* ---------- Live, scroll-controlled version (added by site.ts) ---------- */
  .walk--live { height: 300vh; height: 300svh; }
  .walk--live .walk-pin { position: sticky; top: 0; height: 100vh; height: 100svh; align-content: start; padding-block: clamp(92px, 11vh, 120px) 64px; }
  .walk--live .walk-stage { align-self: center; }
  .walk--live .wp { --k: 0; }
  .walk--live .walk-core { --c: 0; }
  .walk--live .walk-progress { display: block; position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); width: 120px; height: 2px; border-radius: 2px; background: rgba(23,23,21,.12); overflow: hidden; }
  .walk--live .walk-progress span { display: block; height: 100%; background: var(--teal); transform-origin: 0 50%; transform: scaleX(0); }
  @media (min-width: 761px) and (orientation: landscape), (min-width: 1101px) {
    /* panel size follows the screen so both rows always fit between the heading and the controls */
    .walk--live { --pw: min(20vw, calc((100svh - 330px) / 2 * .8), 290px); }
    .walk--live .walk-pin { align-content: space-between; }
  }
  @media (max-width: 760px), (max-width: 1100px) and (orientation: portrait) {
    .walk--live .walk-pin { padding-block: 88px 70px; gap: 14px; }
    .walk--live .walk-stage { max-width: min(560px, calc((100svh - 390px) * .8 + 12px)); }
    .walk--live .walk-toggle { position: absolute; bottom: 14px; right: 14px; min-height: 40px; padding: 0 14px; }
    .walk--live .walk-progress { bottom: 33px; left: 24px; transform: none; width: 96px; }
  }
</style>
