# Copy to .env (never commit .env). All values below are placeholders — none are real.

# Canonical origin of the live site (required for `npm run build:launch`)
SITE_URL=https://www.example.com

# Build mode: leave unset for preview builds; `npm run build:launch` sets PUBLIC_SITE_MODE=launch itself
# PUBLIC_SITE_MODE=launch

# Appointment enquiries — runtime (server) variables
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# ENQUIRY_MODE=log        # development only: accept enquiries and log a redacted summary

# Optional integrations (build time) — use the clinic's own accounts
PUBLIC_GA4_ID=
PUBLIC_GSC_VERIFICATION=

# Server
PORT=4321
HOST=0.0.0.0
